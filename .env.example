# Local Compose defaults. Change POSTGRES_PASSWORD and update DATABASE_URL to match.
POSTGRES_DB=smart_hub
POSTGRES_USER=smart_hub
POSTGRES_PASSWORD=local_only_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smart_hub:local_only_password@localhost:5432/smart_hub?schema=public

PORT=3000
# Required. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:3001

HOLD_MINUTES=5
PICKUP_GRACE_MINUTES=15
JOB_INTERVAL_SECONDS=10
HUB_SYNC_SECONDS=30
HUB_STALE_SECONDS=120
DISPATCH_TIMEOUT_SECONDS=60
MOCK_DISPATCH_FAILURE_PERCENT=0

# Set all three to enable OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Set only on a disposable development database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
